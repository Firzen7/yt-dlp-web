{
  "manifest_version": 3,
  "name": "Yout.com Redirector",
  "version": "1.0",
  "description": "Redirects yout.com video links to the local yt-dlp web downloader.",
  "permissions": [
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "*://*.yout.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Downloader Settings",
    "default_popup": "popup.html"
  }
}
