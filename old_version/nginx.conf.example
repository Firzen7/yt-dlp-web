server {
    listen 80;
    server_name stahovac.firzen.net;

    # Přesměrování veškerého HTTP provozu na HTTPS (Redirect HTTP to HTTPS)
    location / {
        return 301 https://$host$request_uri;
    }

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Podpora pro WebSocket, pokud by byla v budoucnu potřeba
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    server_name stahovac.firzen.net;

    # Cesty k certifikátům (tyto soubory vygeneruje Certbot)
    ssl_certificate /etc/letsencrypt/live/stahovac.firzen.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stahovac.firzen.net/privkey.pem;
    
    # Doporučená bezpečnostní nastavení (Certbot je často přidává automaticky pomocí include)
    # include /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/yt-dlp-web.access.log;
    error_log /var/log/nginx/yt-dlp-web.error.log;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Podpora pro WebSocket, pokud by byla v budoucnu potřeba
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
